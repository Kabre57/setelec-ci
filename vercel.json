{
    "version": 2,
    "builds": [
      {
        "src": "public/**",
        "use": "@vercel/static"
      },
      {
        "src": "index.php",
        "use": "@vercel/php"
      }
    ],
    "routes": [
      {
        "src": "/build/.*",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      },
      {
        "src": "/(.*)",
        "dest": "/public/$1"
      }
    ]
  }
